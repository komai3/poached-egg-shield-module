// Recovered from editor JSON: parsed bindings are authoritative.
// Original keymap blob: d2797932bcd96742ac499fdff0fbf390b6311419
// Requires CONFIG_ZMK_POINTING=y for &mkp MB2.
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
/ {
    behaviors {
        eisu_layer2: eisu_layer2 {
            compatible = "zmk,behavior-tap-dance";
            label = "EISU_LAYER2";
            #binding-cells = <0>;
            bindings = <&lt 2 LANG2>, <&to 2>;
        };
        kana_layer3: kana_layer3 {
            compatible = "zmk,behavior-tap-dance";
            label = "KANA_LAYER3";
            #binding-cells = <0>;
            bindings = <&kp LANG1>, <&to 3>;
        };
    };
    macros {
        ctrl_z: ctrl_z {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(Z)>;
            label = "CTRL_Z";
        };
    };
    keymap {
        compatible = "zmk,keymap";
        // Layer 0; positions 0..49, rows 12 + 12 + 12 + 14.
        default_layer {
            display-name = "Base";
            bindings = <
        		&kp ESC                 &kp Q                   &kp W                   &kp E                   &kp R                   &kp T                   &kp Y                   &kp U                   &kp I                   &kp O                   &kp P                   &kp MINUS
        		&kp TAB                 &kp A                   &kp S                   &kp D                   &kp F                   &kp G                   &kp H                   &kp J                   &kp K                   &kp L                   &kp SLASH               &kp LBKT
        		&kp LSHIFT              &kp Z                   &kp X                   &kp C                   &kp V                   &kp B                   &kp N                   &kp M                   &kp COMMA               &kp DOT                 &kp UP_ARROW            &kp RBKT
                &kp LCTRL               &kp LWIN                &kp LALT                &mo 4                   &lt 1 SPACE             &lt 1 SPACE             &eisu_layer2            &kana_layer3            &kp ENTER               &kp BSPC                &kp DELETE              &kp LEFT_ARROW          &kp DOWN_ARROW          &kp RIGHT_ARROW
            >;
        };
        // Layer 1; positions 0..49, rows 12 + 12 + 12 + 14.
        lower_layer {
            display-name = "Lower";
            bindings = <
                &kp ESC                 &kp N1                  &kp N2                  &kp N3                  &kp N4                  &kp N5                  &kp N6                  &kp N7                  &kp N8                  &kp N9                  &kp N0                  &kp TILDE
                &kp F1                  &kp F2                  &kp F3                  &kp F4                  &kp F5                  &kp F6                  &kp QMARK               &kp EXCL                &kp EQUAL               &kp BSLH                &kp UNDER               &kp LPAR
                &kp F7                  &kp F8                  &kp F9                  &kp F10                 &kp F11                 &kp F12                 &kp AT                  &kp PRCNT               &kp SEMI                &kp SQT                 &mt PAGE_UP HOME        &kp RPAR
                &trans                  &trans                  &trans                  &trans                  &trans                  &trans                  &trans                  &trans                  &trans                  &kp DEL                 &kp HASH                &kp AMPS                &mt PAGE_DOWN END       &kp GRAVE
            >;
        };
        // Layer 2; positions 0..49, rows 12 + 12 + 12 + 14.
        clip_layer {
            display-name = "clip/num";
            bindings = <
                &kp GRAVE               &kp J                   &kp G                   &kp E                   &ctrl_z                 &kp P                   &kp LEFT_BRACKET        &kp KP_SLASH            &kp KP_PLUS             &kp KP_NUMBER_7         &kp KP_NUMBER_8         &kp KP_NUMBER_9
                &mo 4                   &kp W                   &kp LC(D)               &kp M                   &kp F4                  &kp C                   &kp RIGHT_BRACKET       &kp KP_ASTERISK         &kp KP_MINUS            &kp KP_NUMBER_4         &kp KP_NUMBER_5         &kp KP_NUMBER_6
                &kp LC(B)               &kp F5                  &kp LC(LS(D))           &kp DEL                 &mt LSHIFT Q            &mt LALT LC(S)          &kp LEFT_ARROW          &kp KP_NUM              &kp UNDER               &kp KP_NUMBER_1         &kp KP_NUMBER_2         &kp KP_NUMBER_3
                &kp O                   &kp D                   &kp LC(LS(I))           &kp LC(KP_NUMBER_0)     &kp SPACE               &kp LCTRL               &kp Z                   &to 0                   &kp RIGHT_ARROW         &none                   &kp BSPC                &kp KP_NUMBER_0         &kp KP_DOT              &kp KP_ENTER
            >;
        };
        // Layer 3; positions 0..49, rows 12 + 12 + 12 + 14.
        miro_layer {
            display-name = "miro/prcr";
            bindings = <
                &kp ESC                 &kp LS(LC(L))           &kp PAGE_UP             &kp E                   &ctrl_z                 &kp P                   &kp LG(J)               &kp V                   &kp LG(BACKSPACE)       &kp LG(D)               &kp S                   &kp L
                &kp BACKSPACE           &kp G                   &kp PAGE_DOWN           &kp N                   &kp KP_NUMBER_3         &kp V                   &kp SPACE               &kp LG(X)               &kp E                   &kp LEFT_ALT            &kp LG(Z)               &kp B
                &kp LSHIFT              &kp LC(X)               &kp LC(V)               &kp LC(C)               &kp LC(D)               &kp LC(LS(F))           &none                   &kp LG(V)               &kp LG(N0)              &kp LG(SEMI)            &kp C                   &kp RBKT
                &kp LCTRL               &kp LEFT_WIN            &kp LEFT_ALT            &kp TAB                 &kp SPACE               &mkp MB2                &none                   &to 0                   &kp LEFT_GUI            &kp LSHIFT              &kp LG(U)               &kp LG(B)               &kp X                   &kp LBKT
            >;
        };
        // Layer 4; positions 0..49, rows 12 + 12 + 12 + 14.
        bt_layer {
            display-name = "clip2/BT";
            bindings = <
                &kp ESC                 &kp LA(KP_NUMBER_2)     &kp LC(LS(T))           &kp LC(N7)              &kp LC(N5)              &kp LC(N3)              &none                   &bt BT_SEL 0            &bt BT_SEL 1            &bt BT_SEL 2            &bt BT_SEL 3            &bt BT_SEL 4
                &trans                  &kp LA(KP_NUMBER_0)     &kp U                   &kp LS(Q)               &kp LS(I)               &kp X                   &none                   &none                   &none                   &none                   &none                   &bt BT_CLR
                &trans                  &trans                  &kp LC(E)               &kp LC(N6)              &kp F3                  &kp B                   &none                   &none                   &none                   &none                   &none                   &bt BT_CLR_ALL
                &to 0                   &kp T                   &kp K                   &kp LC(LS(F))           &kp Y                   &kp ENTER               &none                   &none                   &none                   &none                   &none                   &none                   &none                   &none
            >;
        };
    };
};
